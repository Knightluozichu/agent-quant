[Unit]
Description=七星V4 实盘记账网页 (FastAPI)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/opt/quant
# 启动前检查端口未被占用 (防止重复启动)
ExecStartPre=/bin/bash -c '! /usr/bin/ss -tlnp | grep -q ":8090 "'
ExecStart=/opt/quant/.venv/bin/python scripts/trade_server.py --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
Environment=TZ=Asia/Shanghai
UMask=0077

# 安全加固 (quant 用户无需访问 /root, 可用 strict)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/quant/data/live
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
