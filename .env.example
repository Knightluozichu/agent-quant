# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
APP_NAME=a_share_quant_life
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
RANDOM_SEED=20260720
DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Optional: read-only production state sync for local intraday previews.
# The script uses the normal OpenSSH config/key chain and never reads remote secrets.
QIXING_SERVER_SSH=root@106.52.243.51
QIXING_REMOTE_DIR=/opt/quant

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
DATA_ROOT=./data
ARTIFACT_ROOT=./artifacts
REPORT_ROOT=./reports
DUCKDB_PATH=./data/quant.duckdb
MARKET_RULES_PATH=./configs/market_rules_cn.yaml

# ------------------------------------------------------------
# Data provider
# mock | local_parquet | joinquant | tushare | akshare
# ------------------------------------------------------------
DATA_PROVIDER=mock
DATA_START_DATE=20100101
DATA_END_DATE=

JOINQUANT_USERNAME=
JOINQUANT_PASSWORD=
TUSHARE_TOKEN=
AKSHARE_ENABLED=false

# ------------------------------------------------------------
# Research protocol
# ------------------------------------------------------------
INITIAL_CAPITAL=100000
BASE_CURRENCY=CNY
BAR_FREQUENCY=1d
SIGNAL_AT=close
EXECUTION_AT=next_open
BENCHMARK_SYMBOL=
UNIVERSE_PROFILE=liquid_etf_mvp
RISK_PROFILE=paper_conservative
FEE_PROFILE=cn_a_share_date_aware

# ------------------------------------------------------------
# Backtest controls
# ------------------------------------------------------------
BACKTEST_ENGINE=event_driven
STRICT_NO_LOOKAHEAD=true
CONSERVATIVE_SAME_BAR_FILL=true
SIMULATE_T_PLUS_ONE=true
SIMULATE_PRICE_LIMITS=true
SIMULATE_SUSPENSIONS=true
SIMULATE_PARTIAL_FILL=false

# ------------------------------------------------------------
# Broker / paper trading
# none | csv_manual | paper | qmt | ptrade
# ------------------------------------------------------------
BROKER_PROVIDER=paper
BROKER_ACCOUNT_ID=
QMT_INSTALL_PATH=
QMT_ACCOUNT_TYPE=STOCK
PTRADE_ENDPOINT=
PTRADE_ACCOUNT_ID=

# ------------------------------------------------------------
# Notifications
# ------------------------------------------------------------
NOTIFY_PROVIDER=console
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL=

# ------------------------------------------------------------
# Safety interlock
# Exact acknowledgement must remain empty until separately approved.
# ------------------------------------------------------------
LIVE_TRADING_ACKNOWLEDGEMENT=
